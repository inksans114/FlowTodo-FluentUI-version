# Local preview: build, then npm start. Node.js 24+ is required.
PORT=4190
APP_ORIGIN=http://localhost:4190
# Development: set PORT=4180 for npm run dev:api (Vite proxy target).
# Production needs NODE_ENV=production, an HTTPS origin, SMTP and Turnstile.
# NODE_ENV=production
# APP_ORIGIN=https://your-domain.example
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=FlowTodo <hello@your-domain.example>
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
